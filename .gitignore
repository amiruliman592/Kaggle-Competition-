.coverage
htmlcov/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Generated by the pipeline (can be rebuilt) ----
# run outputs: checkpoints, EDA plots, reports, raw predictions of a local run
output/
# submission CSVs built locally (the final one is kept in results/phase7/final_run/)
submissions/*.csv
# preprocessed image cache
preprocessed/

# ---- Model files ----
# weights/ keeps only the *.part* files + manifest.json; the joined *.pth (src/weights_io.py unpack) is not committed
*.pth
*.pt
*.pkl
*.log

# ---- Large archives and downloaded external images ----
*.zip
*.tar
*.tar.gz
*.7z
external/images/
# folders that a Google Drive download unpacks into (e.g. weights-20261110T092244Z-1-001/)
*-20[0-9][0-9][0-9][0-9][0-9][0-9]T[0-9]*Z-*/

# ---- Editors, operating system, tools ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
~$*
.gemini/
.claude/
graphify-out/
